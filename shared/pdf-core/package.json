{
  "name": "@signature-kit/pdf-core",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Licitei/signature-kit.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./pdf-core": {
      "types": "./dist/pdf-core.d.ts",
      "import": "./dist/pdf-core.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "import": "./dist/file.js"
    },
    "./promise": {
      "types": "./dist/promise.d.ts",
      "import": "./dist/promise.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./pdf-core.wasm": "./dist/pdf-core.wasm"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@react-pdf/renderer": "4.9.0",
    "binaryen": "130.0.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.1",
    "takumi-pdf": "0.20.0"
  },
  "nx": {
    "targets": {
      "build-wasm": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/rust/Cargo.toml",
          "{projectRoot}/rust/Cargo.lock",
          "{projectRoot}/rust/build.rs",
          "{projectRoot}/rust/data/**/*",
          "{projectRoot}/rust/src/**/*",
          "{projectRoot}/scripts/build-wasm.sh",
          "{projectRoot}/node_modules/binaryen/package.json",
          {
            "runtime": "rustc --version"
          }
        ],
        "outputs": [
          "{projectRoot}/dist/pdf-core.wasm"
        ],
        "options": {
          "command": "bash scripts/build-wasm.sh",
          "cwd": "{projectRoot}"
        }
      },
      "build": {
        "dependsOn": [
          "...",
          "build-wasm"
        ]
      },
      "rust-check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "commands": [
            "cargo fmt --check",
            "cargo clippy --all-targets --all-features -- -D warnings",
            "RUSTDOCFLAGS=\"-D warnings\" cargo doc --no-deps"
          ],
          "parallel": false,
          "cwd": "{projectRoot}/rust"
        }
      },
      "rust-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "cargo test",
          "cwd": "{projectRoot}/rust"
        }
      },
      "npm-pack": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun pm pack --dry-run",
          "cwd": "{projectRoot}"
        }
      },
      "npm-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm publish --access public",
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
