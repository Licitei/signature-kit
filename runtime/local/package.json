{
  "name": "@signature-kit/local",
  "version": "2.0.0-alpha.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Licitei/signature-kit.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/worker.js",
    "./dist/worker-telemetry.js"
  ],
  "exports": {
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./pdf-signatures": {
      "types": "./dist/pdf-signatures.d.ts",
      "import": "./dist/pdf-signatures.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./worker-telemetry": {
      "types": "./dist/worker-telemetry.d.ts",
      "import": "./dist/worker-telemetry.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./telemetry-otlp": {
      "types": "./dist/telemetry-otlp.d.ts",
      "import": "./dist/telemetry-otlp.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "@signature-kit/asn1": "^0.2.1",
    "@signature-kit/certificates": "^0.4.0",
    "@signature-kit/cms": "^0.3.0",
    "@signature-kit/crypto": "^0.3.0",
    "@signature-kit/pdf-core": "^0.4.0",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@signature-kit/a1": "^0.5.0",
    "@signature-kit/pdf": "^0.7.0",
    "pdfjs-dist": "6.3.289"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "4.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2"
  },
  "peerDependenciesMeta": {
    "@effect/opentelemetry": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "nx": {
    "targets": {
      "npm-pack": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun pm pack --dry-run",
          "cwd": "{projectRoot}"
        }
      },
      "npm-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm publish --access public",
          "cwd": "{projectRoot}"
        }
      }
    },
    "tags": [
      "npm:public"
    ]
  }
}
