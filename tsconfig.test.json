{
  "extends": "./tooling/typescript/base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": ".",
    "types": ["bun", "vite/client"],
    "tsBuildInfoFile": ".cache/test-typecheck.tsbuildinfo",
    "allowImportingTsExtensions": true
  },
  "include": [
    "core/**/__tests__/**/*.ts",
    "shared/**/__tests__/**/*.ts",
    "runtime/**/__tests__/**/*.ts",
    "tooling/static-checks/**/*.ts",
    "tooling/testing/**/*.ts",
    "tooling/vitest/**/*.ts"
  ]
}
