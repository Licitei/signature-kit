{
  "name": "@signature-kit/docs",
  "version": "0.0.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config foldkit.vite.config.ts --host 0.0.0.0 --port ${PORT:-3001} --strictPort",
    "build": "vite build --config foldkit.vite.config.ts",
    "start": "bun foldkit/host.mjs",
    "types:check": "tsc -p tsconfig.json --noEmit",
    "foldkit:dev": "bun run dev",
    "foldkit:build": "bun run build",
    "foldkit:start": "bun run start",
    "foldkit:test": "cd ../.. && vitest run --config vitest.config.ts apps/docs/foldkit --exclude '**/*.browser.test.*'"
  },
  "dependencies": {
    "@foldkit/ui": "0.170.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@signature-kit/browser": "workspace:^",
    "@signature-kit/engine": "workspace:^",
    "@stylexjs/stylex": "0.19.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.1.0",
    "foldkit": "0.170.0",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "^12.2.0",
    "posthog-js": "^1.438.13",
    "posthog-node": "^5.56.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwind-merge": "^3.7.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "0.29.0",
    "@hono/node-server": "2.1.5",
    "@stylexjs/unplugin": "0.19.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/jsdom": "^28.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.3.3",
    "unplugin": "2.3.11",
    "vite": "8.3.5"
  },
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist-foldkit/client",
          "{projectRoot}/dist-foldkit/server"
        ]
      },
      "types:check": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.cache/typecheck.tsbuildinfo"
        ]
      }
    }
  }
}
