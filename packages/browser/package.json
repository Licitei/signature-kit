{
  "name": "@signature-kit/browser",
  "version": "2.0.0-alpha.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Licitei/signature-kit.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/signing-helper.js",
    "./dist/signing-worker.js",
    "./dist/worker.js",
    "./dist/worker-telemetry.js"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./worker-telemetry": {
      "types": "./dist/worker-telemetry.d.ts",
      "import": "./dist/worker-telemetry.js"
    },
    "./telemetry-otlp": {
      "types": "./dist/telemetry-otlp.d.ts",
      "import": "./dist/telemetry-otlp.js"
    },
    "./worker-runtime": {
      "types": "./dist/worker-server.d.ts",
      "import": "./dist/worker-server.js"
    },
    "./signing-worker": {
      "types": "./dist/signing-worker.d.ts",
      "import": "./dist/signing-worker.js"
    },
    "./signing-worker-runtime": {
      "types": "./dist/signing-worker-server.d.ts",
      "import": "./dist/signing-worker-server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "@signature-kit/engine": "workspace:^",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@typeonce/effect-machine": "0.47.1",
    "pdfjs-dist": "6.3.289"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "4.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2"
  },
  "peerDependenciesMeta": {
    "@effect/opentelemetry": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "nx": {
    "targets": {
      "npm-pack": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun pm pack --dry-run",
          "cwd": "{projectRoot}"
        }
      },
      "npm-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm publish --access public",
          "cwd": "{projectRoot}"
        }
      }
    },
    "tags": [
      "npm:public",
      "layer:browser"
    ]
  }
}
