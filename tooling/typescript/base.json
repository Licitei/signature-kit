{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "types": ["bun"],
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "isolatedDeclarations": false,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "emitDeclarationOnly": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.json",
    "verbatimModuleSyntax": true,
    "paths": {
      "@signature-kit/asn1": ["../../shared/asn1/src/asn1.ts"],
      "@signature-kit/certificates": ["../../core/certificates/src/index.ts"],
      "@signature-kit/cms/config": ["../../shared/cms/src/config.ts"],
      "@signature-kit/cms/icp-brasil": ["../../shared/cms/src/icp-brasil.ts"],
      "@signature-kit/cms/sign": ["../../shared/cms/src/sign.ts"],
      "@signature-kit/cms/verify": ["../../shared/cms/src/verify.ts"],
      "@signature-kit/cms/inspect": ["../../shared/cms/src/inspect.ts"],
      "@signature-kit/pdf-core/config": ["../../shared/pdf-core/src/config.ts"],
      "@signature-kit/pdf-core/pdf-core": ["../../shared/pdf-core/src/pdf-core.ts"],
      "@signature-kit/pdf-core/browser": ["../../shared/pdf-core/src/browser.ts"],
      "@signature-kit/pdf-core/file": ["../../shared/pdf-core/src/file.ts"],
      "@signature-kit/pdf-core/promise": ["../../shared/pdf-core/src/promise.ts"],
      "@signature-kit/pdf-core/node": ["../../shared/pdf-core/src/node.ts"],
      "@signature-kit/pdf-core/canvas": ["../../shared/pdf-core/src/canvas.ts"],
      "@signature-kit/crypto/base64": ["../../shared/crypto/src/base64.ts"],
      "@signature-kit/crypto/config": ["../../shared/crypto/src/config.ts"],
      "@signature-kit/crypto/pem": ["../../shared/crypto/src/pem.ts"],
      "@signature-kit/crypto/pkcs12": ["../../shared/crypto/src/pkcs12.ts"],
      "@signature-kit/local/protocol": ["../../runtime/local/src/protocol.ts"],
      "@signature-kit/local/engine": ["../../runtime/local/src/engine.ts"],
      "@signature-kit/local/worker": ["../../runtime/local/src/worker.ts"],
      "@signature-kit/local/client": ["../../runtime/local/src/client.ts"],
      "@signature-kit/local/worker-telemetry": ["../../runtime/local/src/worker-telemetry.ts"],
      "@signature-kit/local/telemetry": ["../../runtime/local/src/telemetry.ts"],
      "@signature-kit/local/telemetry-otlp": ["../../runtime/local/src/telemetry-otlp.ts"],
      "@signature-kit/local/viewer": ["../../runtime/local/src/viewer.ts"]
    }
  },
  "display": "Default"
}
