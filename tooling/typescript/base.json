{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "types": ["bun"],
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "isolatedDeclarations": false,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "emitDeclarationOnly": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.json",
    "verbatimModuleSyntax": true,
    "paths": {
      "@signature-kit/engine/compose": ["../../packages/engine/src/compose.ts"],
      "@signature-kit/engine/wasm/compose": ["../../packages/engine/src/wasm/compose.ts"],
      "@signature-kit/engine/templates": ["../../packages/engine/src/templates.ts"],
      "@signature-kit/engine/rpc": ["../../packages/engine/src/rpc.ts"],
      "@signature-kit/engine/engine": ["../../packages/engine/src/engine.ts"],
      "@signature-kit/engine/pdf-signatures": ["../../packages/engine/src/pdf-signatures.ts"],
      "@signature-kit/engine/telemetry": ["../../packages/engine/src/telemetry.ts"],
      "@signature-kit/engine/wasm/config": ["../../packages/engine/src/wasm/config.ts"],
      "@signature-kit/engine/wasm/pdf-core": ["../../packages/engine/src/wasm/pdf-core.ts"],
      "@signature-kit/engine/wasm/browser": ["../../packages/engine/src/wasm/browser.ts"],
      "@signature-kit/engine/wasm/file": ["../../packages/engine/src/wasm/file.ts"],
      "@signature-kit/engine/wasm/promise": ["../../packages/engine/src/wasm/promise.ts"],
      "@signature-kit/engine/wasm/node": ["../../packages/engine/src/wasm/node.ts"],
      "@signature-kit/engine/wasm/canvas": ["../../packages/engine/src/wasm/canvas.ts"],
      "@signature-kit/browser/client": ["../../packages/browser/src/client.ts"],
      "@signature-kit/browser/viewer": ["../../packages/browser/src/viewer.ts"],
      "@signature-kit/browser/worker": ["../../packages/browser/src/worker.ts"],
      "@signature-kit/browser/worker-telemetry": ["../../packages/browser/src/worker-telemetry.ts"],
      "@signature-kit/browser/telemetry-otlp": ["../../packages/browser/src/telemetry-otlp.ts"]
    }
  },
  "display": "Default"
}
